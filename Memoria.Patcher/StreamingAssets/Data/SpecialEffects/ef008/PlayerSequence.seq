// Player sequence of SFX Cure__Single

WaitAnimation: Char=Caster
StartThread: Condition=CasterRow == 0 && AreCasterAndSelectedTargetsEnemies ; Sync=True
	MoveToPosition: Char=Caster ; RelativePosition=(0, 0, 400) ; Anim=MP_STEP_FORWARD
	WaitMove: Char=Caster
EndThread
StartThread: Condition=IsSingleSelectedTarget
	Turn: Char=Caster ; BaseAngle=AllTargets ; Time=5
EndThread
Message: Text=[CastName] ; Priority=1 ; Title=True ; Reflect=True
SetupReflect: Delay=SFXLoaded
StartThread: Condition=CasterHasSA(1027) && ItemUseId == 236 && TargetIsPlayer ; Sync

	StartThread: Condition=CommandTargetId == 1
		SetVariable: Variable=gEventGlobal ; Index=1326 ; Value=1
	ElseThread: Condition=CommandTargetId == 2
		SetVariable: Variable=gEventGlobal ; Index=1326 ; Value=2
	ElseThread: Condition=CommandTargetId == 4
		SetVariable: Variable=gEventGlobal ; Index=1326 ; Value=4
	ElseThread
		SetVariable: Variable=gEventGlobal ; Index=1326 ; Value=8
	EndThread
	
	StartThread: Target=AllPlayers ; Sync
		LoadSFX: SFX=Cure__Multi ; Reflect=True
		PlayAnimation: Char=Caster ; Anim=MP_ITEM1
		WaitAnimation: Char=Caster
		WaitSFXLoaded: SFX=Cure__Multi ; Reflect=True
		PlaySFX: SFX=Cure__Multi ; Reflect=True ; MeshColors=(1.0, 0.2, 0.2)
		WaitSFXDone: SFX=Cure__Multi ; Reflect=True
	EndThread
ElseThread: Condition=CasterHasSA(1027) && ItemUseId == 236 && !TargetIsPlayer ; Sync

	StartThread: Condition=CommandTargetId == 16
		SetVariable: Variable=gEventGlobal ; Index=1326 ; Value=16
	ElseThread: Condition=CommandTargetId == 32
		SetVariable: Variable=gEventGlobal ; Index=1326 ; Value=32
	ElseThread: Condition=CommandTargetId == 64
		SetVariable: Variable=gEventGlobal ; Index=1326 ; Value=64
	ElseThread
		SetVariable: Variable=gEventGlobal ; Index=1326 ; Value=128
	EndThread
	
	StartThread: Target=AllEnemies ; Sync
		LoadSFX: SFX=Cure__Multi ; Reflect=True ; Target = AllEnemies
		PlayAnimation: Char=Caster ; Anim=MP_ITEM1
		WaitAnimation: Char=Caster
		WaitSFXLoaded: SFX=Cure__Multi ; Reflect=True
		PlaySFX: SFX=Cure__Multi ; Reflect=True ; MeshColors=(1.0, 0.2, 0.2)
		WaitSFXDone: SFX=Cure__Multi ; Reflect=True
	EndThread
ElseThread: Sync
	StartThread: Condition=IsSingleTarget ; Sync=True
		LoadSFX: SFX=Cure__Single ; Reflect=True
		StartThread: Condition=ItemUseId == 255 ; Sync=True
			PlayAnimation: Char=Caster ; Anim=MP_IDLE_TO_CHANT
			WaitAnimation: Char=Caster
			PlayAnimation: Char=Caster ; Anim=MP_CHANT ; Loop=True
			Channel
			WaitSFXLoaded: SFX=Cure__Single ; Reflect=True
			WaitAnimation: Char=Caster
			StopChannel
			PlayAnimation: Char=Caster ; Anim=MP_MAGIC
			WaitAnimation: Char=Caster
			PlaySFX: SFX=Cure__Single ; Reflect=True ; MeshColors=(0.368, 0.371, 0.261)
		EndThread
		StartThread: Condition=ItemUseId != 255 ; Sync=True
			PlayAnimation: Char=Caster ; Anim=MP_ITEM1
			WaitAnimation: Char=Caster
			WaitSFXLoaded: SFX=Cure__Single ; Reflect=True
			PlaySFX: SFX=Cure__Single ; Reflect=True ; MeshColors=(1.0, 0.2, 0.2)
		EndThread
		WaitSFXDone: SFX=Cure__Single ; Reflect=True
	EndThread
	StartThread: Condition=!IsSingleTarget ; Sync=True
		StartThread: Condition=ItemUseId == 255 ; Sync=True
			PlayAnimation: Char=Caster ; Anim=MP_IDLE_TO_CHANT
			WaitAnimation: Char=Caster
			PlayAnimation: Char=Caster ; Anim=MP_CHANT ; Loop=True
			Channel
			WaitAnimation: Char=Caster
			WaitAnimation: Char=Caster
			StopChannel
			PlayAnimation: Char=Caster ; Anim=MP_MAGIC
			WaitAnimation: Char=Caster
		EndThread
		StartThread: Condition=ItemUseId != 255 ; Sync=True
			PlayAnimation: Char=Caster ; Anim=MP_ITEM1
			WaitAnimation: Char=Caster
		EndThread
		StartThread: TargetLoop=True ; Chain=True ; Sync=True
			LoadSFX: SFX=Cure__Single ; Reflect=True ; UseCamera=False
			WaitSFXLoaded: SFX=Cure__Single ; Reflect=True
			PlaySFX: SFX=Cure__Single ; Reflect=True
			Wait: Time=10
		EndThread
		WaitSFXDone: SFX=Cure__Single ; Reflect=True
	EndThread
EndThread
ActivateReflect
WaitReflect
StartThread: Condition=CasterRow == 0 && AreCasterAndSelectedTargetsEnemies ; Sync=True
	MoveToPosition: Char=Caster ; RelativePosition=(0, 0, -400) ; Anim=MP_STEP_BACK
	WaitMove: Char=Caster
EndThread
PlayAnimation: Char=Caster ; Anim=Idle
Turn: Char=Caster ; BaseAngle=Default ; Time=5
WaitTurn: Char=Caster
