		EffectPoint: Char=AllTargets ; Type=Effect
		EffectPoint: Char=Everyone ; Type=Figure
	EndThread
	StartThread: Condition=GetMemoriaDictionary(1000, 1) >= 3
		Wait: Time=2
		EffectPoint: Char=AllTargets ; Type=Effect
		EffectPoint: Char=Everyone ; Type=Figure
	EndThread
	Wait: Time=19
	WaitSFXDone: SFX=Iai_Strike_1 ; Reflect=True
EndThread
