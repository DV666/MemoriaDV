WaitMove: Char=Caster
MoveToTarget: Char=Caster ; Target=AllTargets ; Distance=0 ; UseCollisionRadius=True ; Anim=MP_RUN_TO_ATTACK
WaitMove: Char=Caster
StartThread
	Wait: Time=1
	WaitSFXLoaded: SFX=Iai_Strike_1 ; Reflect=True
	PlaySFX: SFX=Iai_Strike_1 ; Reflect=True ; SkipSequence
	PlaySound: Sound=599
	PlaySound: Sound=590
	PlaySound: Sound=582
	Wait: Time=1
	EffectPoint: Char=AllTargets ; Type=Effect
	Wait: Time=3
	EffectPoint: Char=Everyone ; Type=Figure
	StartThread: Condition=GetMemoriaDictionary(1000, 1) >= 1
