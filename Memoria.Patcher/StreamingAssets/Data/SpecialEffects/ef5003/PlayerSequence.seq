// Player sequence of SFX Mana Well

WaitAnimation: Char=Caster
StartThread: Condition=IsSingleSelectedTarget
	Turn: Char=Caster ; BaseAngle=AllTargets ; Time=5
EndThread
Message: Text=[CastName] ; Priority=1 ; Title=True ; Reflect=True
SetupReflect: Delay=SFXLoaded
LoadSFX: SFX=Vaccine ; Reflect=True
PlayAnimation: Char=Caster ; Anim=ANH_MAIN_B0_006_BTL_MANAWELL1
WaitAnimation: Char=Caster
PlayAnimation: Char=Caster ; Anim=ANH_MAIN_B0_006_BTL_MANAWELL2 ; Loop=True
Channel
WaitSFXLoaded: SFX=Vaccine ; Reflect=True
WaitAnimation: Char=Caster
StopChannel
PlaySFX: SFX=Vaccine ; Reflect=True ; MeshColors=(0.0, 0.0, 0.5)
WaitSFXDone: SFX=Vaccine ; Reflect=True
PlayAnimation: Char=Caster ; Anim=ANH_MAIN_B0_006_BTL_MANAWELL3
WaitAnimation: Char=Caster
ActivateReflect
WaitReflect
PlayAnimation: Char=Caster ; Anim=Idle
Turn: Char=Caster ; BaseAngle=Default ; Time=5
WaitTurn: Char=Caster
